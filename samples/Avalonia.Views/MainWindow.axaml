<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sample.ViewModels"
        x:Class="Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1100"
        Height="720"
        Background="#1E1E2E">
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top"
               Margin="0,0,0,12"
               FontSize="18"
               Foreground="White"
               Text="{Binding StatusText}" />

    <Border DockPanel.Dock="Right"
            Width="300"
            Margin="12,0,0,0"
            Padding="12"
            CornerRadius="12"
            Background="#2A2A3C">
      <StackPanel Spacing="10">
        <TextBlock FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="White"
                   Text="Clipboard preview" />

        <Button Content="Paste from clipboard"
                HorizontalAlignment="Stretch"
                Click="OnPasteFromClipboardClick" />

        <Border MinHeight="220"
                Padding="8"
                CornerRadius="8"
                Background="#1E1E2E">
          <Image x:Name="ClipboardPreviewImage"
                 Stretch="Uniform"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />
        </Border>

        <TextBlock x:Name="ClipboardPreviewStatus"
                   FontSize="13"
                   Foreground="#B0B0C0"
                   TextWrapping="Wrap"
                   Text="Copy or save a capture, then verify the image here." />
      </StackPanel>
    </Border>

    <DockPanel>
      <StackPanel DockPanel.Dock="Bottom"
                  Margin="6,12,6,0"
                  Spacing="6">
        <Button Content="Copy main window to clipboard"
                HorizontalAlignment="Stretch"
                Click="OnCopyMainWindowClick" />
        <Button Content="Save main window to file…"
                HorizontalAlignment="Stretch"
                Click="OnSaveMainWindowClick" />
      </StackPanel>

      <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <Grid x:Name="PanelsHost"
              HorizontalAlignment="Stretch" />
      </ScrollViewer>
    </DockPanel>
  </DockPanel>
</Window>
