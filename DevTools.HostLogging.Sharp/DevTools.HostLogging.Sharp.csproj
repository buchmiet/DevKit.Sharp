<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <Description>Startup-phase reporting for .NET hosts: timestamped boot lines and a console progress bar. Sinks: console (allocated on demand for GUI apps), file, or a detached runner process over a named pipe. Driven by --devtools-hostlog.</Description>
    <PackageTags>startup;boot;logging;console;progress-bar;diagnostics;devtools</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DevTools.HostLogging.Runner" />
    <InternalsVisibleTo Include="DevTools.HostLogging.Sharp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
