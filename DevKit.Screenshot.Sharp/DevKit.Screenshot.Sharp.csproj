<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <Description>Framework-agnostic contract for capturing app-window screenshots: IScreenshot, ScreenshotOptions and the --devkit-screenshot CLI parser. Pair with DevKit.Screenshot.Avalonia.Sharp or DevKit.Screenshot.WinUi3.Sharp.</Description>
    <PackageTags>screenshot;capture;ui-testing;visual-testing;ci;devkit</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
