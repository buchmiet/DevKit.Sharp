<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinUi3.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DevTools.Screenshot Sample">

    <Grid x:Name="RootGrid"
          Background="#1E1E2E"
          Padding="16"
          RowDefinitions="Auto,*">
        <TextBlock x:Name="StatusText"
                   Grid.Row="0"
                   Margin="0,0,0,12"
                   FontSize="18"
                   Foreground="White"
                   TextWrapping="Wrap" />

        <Grid x:Name="PanelsGrid"
              Grid.Row="1"
              ColumnDefinitions="*,*,*"
              RowDefinitions="*,*" />
    </Grid>
</Window>
